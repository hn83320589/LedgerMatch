<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="LedgerMatch.App.Views.PeriodsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:LedgerMatch.Presentation.ViewModels">
    <Grid Padding="24,16" ColumnSpacing="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="2" Text="結帳與待處理" Style="{StaticResource TitleTextBlockStyle}" />

        <StackPanel Grid.Row="1" Spacing="8">
            <TextBlock Text="月份" Style="{StaticResource SubtitleTextBlockStyle}" />
            <ListView ItemsSource="{x:Bind ViewModel.Months}" SelectedItem="{x:Bind ViewModel.SelectedMonth, Mode=TwoWay}" Height="320"
                      BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:MonthItem">
                        <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,4">
                            <TextBlock Text="{x:Bind Month}" Width="70" />
                            <TextBlock Text="{x:Bind Status}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="結帳所選月份" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.CloseCommand}" />
                <Button Content="重新開帳…" Command="{x:Bind ViewModel.ReopenCommand}" />
            </StackPanel>
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="8">
            <TextBlock Text="待處理（日期落在已結帳月份的匯入交易）" Style="{StaticResource SubtitleTextBlockStyle}" />
            <ListView ItemsSource="{x:Bind ViewModel.Pending}" SelectionMode="None" Height="280"
                      BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:PendingItemViewModel">
                        <CheckBox Content="{x:Bind Text}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="改列入下一個未結帳月份（保留原日期）" Command="{x:Bind ViewModel.PostSelectedCommand}" />
                <Button Content="捨棄" Command="{x:Bind ViewModel.DiscardSelectedCommand}" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="4">
            <TextBlock Text="結帳紀錄" Style="{StaticResource SubtitleTextBlockStyle}" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Events}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{x:Bind}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</UserControl>
