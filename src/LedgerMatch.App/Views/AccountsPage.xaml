<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="LedgerMatch.App.Views.AccountsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:LedgerMatch.App"
    xmlns:vm="using:LedgerMatch.Presentation.ViewModels"
    xmlns:domain="using:LedgerMatch.Core.Domain"
    xmlns:importing="using:LedgerMatch.Core.Importing">
    <ScrollViewer Padding="24,16">
        <StackPanel Spacing="20" MaxWidth="1200" HorizontalAlignment="Left">
            <TextBlock Text="帳戶與映射設定檔" Style="{StaticResource TitleTextBlockStyle}" />

            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="8">
                    <TextBlock Text="設定檔" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ListView ItemsSource="{x:Bind ViewModel.Profiles}" SelectedItem="{x:Bind ViewModel.SelectedProfile, Mode=TwoWay}"
                              Height="260" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="importing:MappingProfile">
                                <StackPanel Padding="0,4">
                                    <TextBlock Text="{x:Bind Name}" />
                                    <TextBlock Text="{x:Bind app:Ui.KindName(Kind)}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="新增" Command="{x:Bind ViewModel.NewProfileCommand}" />
                        <Button Content="編輯" Command="{x:Bind ViewModel.EditProfileCommand}" />
                        <Button Content="刪除" Command="{x:Bind ViewModel.DeleteProfileCommand}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="10" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <TextBlock Text="設定檔內容" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="欄位可填標題名稱，或用 #欄號（例如 #3 表示第 3 欄）；不使用的欄位留空。日期格式可用分號列出多個。" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Grid ColumnSpacing="12" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBox Header="名稱" Text="{x:Bind ViewModel.Editor.Name, Mode=TwoWay}" />
                        <ComboBox Grid.Column="1" Header="用途" HorizontalAlignment="Stretch" SelectedIndex="{x:Bind ViewModel.Editor.KindIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="銀行對帳單" />
                            <ComboBoxItem Content="收款單" />
                        </ComboBox>
                        <ComboBox Grid.Column="2" Header="編碼" HorizontalAlignment="Stretch" SelectedIndex="{x:Bind ViewModel.Editor.EncodingIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="UTF-8" />
                            <ComboBoxItem Content="Big5" />
                        </ComboBox>

                        <TextBox Grid.Row="1" Header="分隔符號（Tab 填 \t）" Text="{x:Bind ViewModel.Editor.Delimiter, Mode=TwoWay}" />
                        <NumberBox Grid.Row="1" Grid.Column="1" Header="標題列數" Minimum="0" Maximum="20" SpinButtonPlacementMode="Inline"
                                   Value="{x:Bind app:Ui.ToDouble(ViewModel.Editor.HeaderRowCount), BindBack=SetHeaderRows, Mode=TwoWay}" />
                        <TextBox Grid.Row="1" Grid.Column="2" Header="千分位符號（無則留空）" Text="{x:Bind ViewModel.Editor.ThousandsSeparator, Mode=TwoWay}" />

                        <TextBox Grid.Row="2" Header="日期欄" Text="{x:Bind ViewModel.Editor.DateColumn, Mode=TwoWay}" />
                        <TextBox Grid.Row="2" Grid.Column="1" Header="日期格式" Text="{x:Bind ViewModel.Editor.DateFormats, Mode=TwoWay}" />
                        <CheckBox Grid.Row="2" Grid.Column="2" VerticalAlignment="Bottom" Content="民國年（年份 +1911 後套用 yyyy）"
                                  IsChecked="{x:Bind ViewModel.Editor.RocYear, Mode=TwoWay}" />

                        <ComboBox Grid.Row="3" Header="金額表示法" HorizontalAlignment="Stretch" SelectedIndex="{x:Bind ViewModel.Editor.AmountModeIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="單一金額欄（含正負）" />
                            <ComboBoxItem Content="借方、貸方兩欄" />
                        </ComboBox>
                        <TextBox Grid.Row="3" Grid.Column="1" Header="金額欄" Text="{x:Bind ViewModel.Editor.AmountColumn, Mode=TwoWay}"
                                 Visibility="{x:Bind app:Ui.Hidden(ViewModel.Editor.IsDebitCredit), Mode=OneWay}" />
                        <TextBox Grid.Row="3" Grid.Column="1" Header="借方（支出）欄" Text="{x:Bind ViewModel.Editor.DebitColumn, Mode=TwoWay}"
                                 Visibility="{x:Bind app:Ui.Visible(ViewModel.Editor.IsDebitCredit), Mode=OneWay}" />
                        <TextBox Grid.Row="3" Grid.Column="2" Header="貸方（存入）欄" Text="{x:Bind ViewModel.Editor.CreditColumn, Mode=TwoWay}"
                                 Visibility="{x:Bind app:Ui.Visible(ViewModel.Editor.IsDebitCredit), Mode=OneWay}" />
                        <CheckBox Grid.Row="3" Grid.Column="2" VerticalAlignment="Bottom" Content="括號表示負數，如 (1,200)"
                                  IsChecked="{x:Bind ViewModel.Editor.ParenthesesNegative, Mode=TwoWay}"
                                  Visibility="{x:Bind app:Ui.Hidden(ViewModel.Editor.IsDebitCredit), Mode=OneWay}" />

                        <TextBox Grid.Row="4" Header="摘要欄" Text="{x:Bind ViewModel.Editor.DescriptionColumn, Mode=TwoWay}"
                                 Visibility="{x:Bind app:Ui.Visible(ViewModel.Editor.IsStatement), Mode=OneWay}" />
                        <TextBox Grid.Row="4" Grid.Column="1" Header="交易序號欄（選用）" Text="{x:Bind ViewModel.Editor.SerialColumn, Mode=TwoWay}"
                                 Visibility="{x:Bind app:Ui.Visible(ViewModel.Editor.IsStatement), Mode=OneWay}" />
                        <TextBox Grid.Row="4" Header="客戶名稱欄" Text="{x:Bind ViewModel.Editor.CustomerColumn, Mode=TwoWay}"
                                 Visibility="{x:Bind app:Ui.Hidden(ViewModel.Editor.IsStatement), Mode=OneWay}" />
                        <TextBox Grid.Row="4" Grid.Column="1" Header="單據編號欄" Text="{x:Bind ViewModel.Editor.ReceiptNoColumn, Mode=TwoWay}"
                                 Visibility="{x:Bind app:Ui.Hidden(ViewModel.Editor.IsStatement), Mode=OneWay}" />
                        <TextBox Grid.Row="4" Grid.Column="2" Header="備註欄（選用）" Text="{x:Bind ViewModel.Editor.NoteColumn, Mode=TwoWay}" />
                        <TextBox Grid.Row="5" Header="入帳帳戶欄（選用，填帳戶名稱）" Text="{x:Bind ViewModel.Editor.AccountNameColumn, Mode=TwoWay}"
                                 Visibility="{x:Bind app:Ui.Hidden(ViewModel.Editor.IsStatement), Mode=OneWay}" />
                    </Grid>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.Editor.ValidationErrors}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="儲存設定檔" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.Editor.SaveCommand}" />
                        <Button Content="用這組設定試讀檔案…" Command="{x:Bind ViewModel.Editor.PreviewFileCommand}" />
                        <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.Editor.StatusMessage, Mode=OneWay}" />
                    </StackPanel>

                    <Grid ColumnSpacing="16" Visibility="{x:Bind app:Ui.VisibleIfText(ViewModel.Editor.StatusMessage), Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ListView Header="解析結果（前 200 列）" ItemsSource="{x:Bind ViewModel.Editor.PreviewRows}" MaxHeight="260">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:PreviewRow">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Line}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Date}" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind Amount}" TextAlignment="Right" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind Description}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="4" Text="{x:Bind Extra}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <ListView Grid.Column="1" Header="錯誤列" ItemsSource="{x:Bind ViewModel.Editor.PreviewErrors}" MaxHeight="260">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="importing:RowError">
                                    <TextBlock TextWrapping="Wrap">
                                        <Run Text="第" /><Run Text="{x:Bind LineNumber}" /><Run Text="列：" /><Run Text="{x:Bind Reason}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </StackPanel>
            </Grid>

            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="8">
                    <TextBlock Text="銀行帳戶" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ListView ItemsSource="{x:Bind ViewModel.Accounts}" SelectedItem="{x:Bind ViewModel.SelectedAccount, Mode=TwoWay}" Height="160"
                              BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="domain:Account">
                                <TextBlock Text="{x:Bind Name}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button Content="新增帳戶" Command="{x:Bind ViewModel.NewAccountCommand}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="10" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <TextBlock Text="帳戶內容" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Header="帳戶名稱" Text="{x:Bind ViewModel.AccountName, Mode=TwoWay}" />
                        <ComboBox Grid.Column="1" Header="對帳單設定檔" HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind ViewModel.StatementProfiles}" SelectedItem="{x:Bind ViewModel.AccountProfile, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="importing:MappingProfile">
                                    <TextBlock Text="{x:Bind Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBox Grid.Column="2" Header="期初餘額" Text="{x:Bind ViewModel.OpeningBalance, Mode=TwoWay}" />
                        <TextBox Grid.Column="3" Header="期初日期（yyyy-MM-dd）" Text="{x:Bind ViewModel.OpeningDate, Mode=TwoWay}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="儲存帳戶" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveAccountCommand}" />
                        <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
