<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="LedgerMatch.App.Views.MatchingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:LedgerMatch.App"
    xmlns:vm="using:LedgerMatch.Presentation.ViewModels">
    <Grid Padding="24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="配對" Style="{StaticResource TitleTextBlockStyle}" />
            <Button Content="執行自動配對" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.RunCommand}"
                    IsEnabled="{x:Bind ViewModel.IsEditable, Mode=OneWay}" />
            <Button Content="取消" Command="{x:Bind ViewModel.CancelCommand}" />
            <ProgressBar Width="220" Maximum="100" Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}"
                         Visibility="{x:Bind app:Ui.Visible(ViewModel.IsRunning), Mode=OneWay}" />
            <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="4">
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Warnings}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{x:Bind}" Foreground="{ThemeResource SystemFillColorCautionBrush}" TextWrapping="Wrap" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Grid Grid.Row="2" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="確認勾選" Command="{x:Bind ViewModel.ConfirmSelectedCommand}" IsEnabled="{x:Bind ViewModel.IsEditable, Mode=OneWay}" />
                <Button Content="全部建議確認" Command="{x:Bind ViewModel.ConfirmAllSuggestionsCommand}" IsEnabled="{x:Bind ViewModel.IsEditable, Mode=OneWay}" />
                <Button Content="拒絕勾選的建議" Command="{x:Bind ViewModel.RejectSelectedCommand}" IsEnabled="{x:Bind ViewModel.IsEditable, Mode=OneWay}" />
                <Button Content="解除勾選的配對" Command="{x:Bind ViewModel.UnmatchSelectedCommand}" IsEnabled="{x:Bind ViewModel.IsEditable, Mode=OneWay}" />
            </StackPanel>
            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Matches}" SelectionMode="None"
                      BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:MatchItem">
                        <Grid ColumnSpacing="12" Padding="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>
                            <CheckBox MinWidth="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind DepositText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ReceiptsText}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind Note}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock Grid.Column="3" Text="{x:Bind Kind}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="{x:Bind Confidence}" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="5" Text="{x:Bind Fee}" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="12">
            <TextBlock Text="人工配對" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.ManualSummary, Mode=OneWay}" />
            <CheckBox Content="差額列為手續費" IsChecked="{x:Bind ViewModel.AcceptDifferenceAsFee, Mode=TwoWay}" />
            <Button Content="配對所選" Command="{x:Bind ViewModel.ManualMatchCommand}" IsEnabled="{x:Bind ViewModel.IsEditable, Mode=OneWay}" />
        </StackPanel>

        <Grid Grid.Row="4" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ListView Header="未配對入帳（選一筆）" ItemsSource="{x:Bind ViewModel.UnmatchedDeposits}" SelectionMode="None"
                      BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:SelectableTransaction">
                        <CheckBox Content="{x:Bind Text}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <ListView Grid.Column="1" Header="未配對收款單（可多選）" ItemsSource="{x:Bind ViewModel.UnmatchedReceipts}" SelectionMode="None"
                      BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:SelectableReceipt">
                        <CheckBox Content="{x:Bind Text}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</UserControl>
