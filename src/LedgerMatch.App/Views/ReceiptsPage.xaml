<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="LedgerMatch.App.Views.ReceiptsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:LedgerMatch.Presentation.ViewModels">
    <Grid Padding="24,16" ColumnSpacing="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="16">
            <TextBlock Text="收款單（本月）" Style="{StaticResource TitleTextBlockStyle}" />
            <CheckBox Content="只顯示未配對" IsChecked="{x:Bind ViewModel.OnlyUnmatched, Mode=TwoWay}" VerticalAlignment="Center" />
            <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
        </StackPanel>

        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Items}" SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}"
                  BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:ReceiptItem">
                    <Grid ColumnSpacing="12" Padding="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Date}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Receipt.ReceiptNo}" />
                        <TextBlock Grid.Column="2" Text="{x:Bind Receipt.Customer}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="3" Text="{x:Bind Amount}" TextAlignment="Right" FontFamily="Consolas" />
                        <TextBlock Grid.Column="4" Text="{x:Bind Status}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="10" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <TextBlock Text="收款單內容" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBox Header="開立日期（yyyy-MM-dd）" Text="{x:Bind ViewModel.IssueDate, Mode=TwoWay}" />
            <TextBox Header="客戶名稱" Text="{x:Bind ViewModel.Customer, Mode=TwoWay}" />
            <TextBox Header="單據編號" Text="{x:Bind ViewModel.ReceiptNo, Mode=TwoWay}" />
            <TextBox Header="金額" Text="{x:Bind ViewModel.Amount, Mode=TwoWay}" />
            <TextBox Header="備註" Text="{x:Bind ViewModel.Note, Mode=TwoWay}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="新增" Command="{x:Bind ViewModel.NewCommand}" />
                <Button Content="儲存" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveCommand}" IsEnabled="{x:Bind ViewModel.IsEditable, Mode=OneWay}" />
                <Button Content="刪除" Command="{x:Bind ViewModel.DeleteCommand}" IsEnabled="{x:Bind ViewModel.IsEditable, Mode=OneWay}" />
            </StackPanel>
            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="已配對的收款單不能刪除或修改金額、日期；請先到「配對」頁解除配對。" />
        </StackPanel>
    </Grid>
</UserControl>
