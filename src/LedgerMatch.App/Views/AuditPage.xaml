<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="LedgerMatch.App.Views.AuditPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:LedgerMatch.Presentation.ViewModels">
    <Grid Padding="24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="稽核紀錄（唯讀）" Style="{StaticResource TitleTextBlockStyle}" />
            <Button Content="重新載入" Command="{x:Bind ViewModel.ReloadCommand}" />
            <Button Content="載入更多" Command="{x:Bind ViewModel.LoadMoreCommand}" />
            <Button Content="驗證完整性" Command="{x:Bind ViewModel.VerifyCommand}" />
            <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
        </StackPanel>
        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Items}" SelectionMode="Single"
                  BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:AuditItem">
                    <Grid ColumnSpacing="12" Padding="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind At}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Entry.Operation}" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="2" Text="{x:Bind Target}" />
                        <TextBlock Grid.Column="3" Text="{x:Bind Action}" />
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="{x:Bind Before}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" />
                            <TextBlock Text="{x:Bind After}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" IsTextSelectionEnabled="True" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
