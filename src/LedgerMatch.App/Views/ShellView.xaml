<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="LedgerMatch.App.Views.ShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:LedgerMatch.App"
    xmlns:domain="using:LedgerMatch.Core.Domain">
    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Modifiers="Control" Key="Z" Invoked="OnUndoAccelerator" />
        <KeyboardAccelerator Modifiers="Control" Key="Y" Invoked="OnRedoAccelerator" />
    </UserControl.KeyboardAccelerators>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="16,10" ColumnSpacing="12" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="帳務對帳房" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" Header="帳戶" MinWidth="200" PlaceholderText="尚未建立帳戶"
                      ItemsSource="{x:Bind Shell.Accounts}"
                      SelectedItem="{x:Bind Shell.SelectedAccount, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="domain:Account">
                        <TextBlock Text="{x:Bind Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox Grid.Column="2" Header="月份" MinWidth="130"
                      ItemsSource="{x:Bind Shell.Months}"
                      SelectedIndex="{x:Bind Shell.SelectedMonthIndex, Mode=TwoWay}" />
            <TextBlock Grid.Column="3" VerticalAlignment="Bottom" Margin="0,0,0,6"
                       Text="{x:Bind Shell.MonthStatus, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
                <Button Command="{x:Bind Shell.UndoCommand}" ToolTipService.ToolTip="{x:Bind Shell.UndoDescription, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <SymbolIcon Symbol="Undo" />
                        <TextBlock Text="復原" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind Shell.RedoCommand}" ToolTipService.ToolTip="{x:Bind Shell.RedoDescription, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <SymbolIcon Symbol="Redo" />
                        <TextBlock Text="重做" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <InfoBar Grid.Row="1" Severity="Warning" IsClosable="False"
                 IsOpen="{x:Bind Shell.IsCurrentMonthClosed, Mode=OneWay}"
                 Title="此月份已結帳"
                 Message="交易、配對、拆分與歸類都不能修改；如需更正，請到「結帳」頁輸入理由重新開帳。" />

        <NavigationView x:Name="Nav" Grid.Row="2" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False" OpenPaneLength="200" SelectionChanged="OnNavigate">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="帳戶與設定檔" Tag="accounts" Icon="Contact" />
                <NavigationViewItem Content="匯入" Tag="import" Icon="Download" />
                <NavigationViewItem Content="交易" Tag="transactions" Icon="List" />
                <NavigationViewItem Content="收款單" Tag="receipts" Icon="Page" />
                <NavigationViewItem Content="配對" Tag="matching" Icon="Link" />
                <NavigationViewItem Content="科目與規則" Tag="rules" Icon="Filter" />
                <NavigationViewItem Content="調節表" Tag="reconciliation" Icon="Calculator" />
                <NavigationViewItem Content="結帳" Tag="periods" Icon="ProtectedDocument" />
                <NavigationViewItem Content="稽核紀錄" Tag="audit" Icon="Library" />
                <NavigationViewItem Content="配對參數" Tag="settings" Icon="Setting" />
            </NavigationView.MenuItems>
            <ContentControl x:Name="PageHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </NavigationView>
    </Grid>
</UserControl>
