<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="LedgerMatch.App.Views.ImportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:LedgerMatch.App"
    xmlns:importing="using:LedgerMatch.Core.Importing">
    <ScrollViewer Padding="24,16">
        <StackPanel Spacing="20" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="匯入" Style="{StaticResource TitleTextBlockStyle}" />

            <StackPanel Spacing="10" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <TextBlock Text="銀行對帳單" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.Target, Mode=OneWay}" />
                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="使用帳戶綁定的映射設定檔解析。同一檔案或日期重疊的檔案可重複匯入，不會產生重複交易；日期落在已結帳月份的交易會放入「結帳」頁的待處理佇列。" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="選擇對帳單檔案並匯入…" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.ImportStatementCommand}"
                            IsEnabled="{x:Bind app:Ui.Not(ViewModel.IsImporting), Mode=OneWay}" />
                    <Button Content="取消" Command="{x:Bind ViewModel.CancelCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12" Visibility="{x:Bind app:Ui.Visible(ViewModel.IsImporting), Mode=OneWay}">
                    <ProgressRing IsActive="True" Width="20" Height="20" />
                    <TextBlock Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="10" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <TextBlock Text="收款單" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="設定檔若有「入帳帳戶」欄，依每列的帳戶名稱歸屬；否則歸入上方選擇的帳戶。單據編號已存在且內容相同者略過。" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox MinWidth="220" PlaceholderText="收款單設定檔" ItemsSource="{x:Bind ViewModel.ReceiptProfiles}"
                              SelectedItem="{x:Bind ViewModel.SelectedReceiptProfile, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="importing:MappingProfile">
                                <TextBlock Text="{x:Bind Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="選擇收款單檔案並匯入…" Command="{x:Bind ViewModel.ImportReceiptsCommand}" />
                </StackPanel>
            </StackPanel>

            <InfoBar Title="匯入結果" Severity="Success" IsClosable="False"
                     IsOpen="{x:Bind app:Ui.HasText(ViewModel.Summary), Mode=OneWay}"
                     Message="{x:Bind ViewModel.Summary, Mode=OneWay}" />

            <ListView Header="錯誤列（其餘列已照常匯入）" ItemsSource="{x:Bind ViewModel.Errors}" MaxHeight="360"
                      Visibility="{x:Bind app:Ui.VisibleIfText(ViewModel.Summary), Mode=OneWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="importing:RowError">
                        <TextBlock TextWrapping="Wrap">
                            <Run Text="第" /><Run Text="{x:Bind LineNumber}" /><Run Text="列：" /><Run Text="{x:Bind Reason}" />
                        </TextBlock>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</UserControl>
